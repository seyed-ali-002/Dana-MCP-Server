# Dana MCP Server — environment example
# Copy to .env or ~/.config/dana/.env and adjust values.
# Never commit real tokens or secrets.

# Core runtime
DANA_HOST=127.0.0.1
DANA_PORT=8765
DANA_LOG_LEVEL=info
DANA_WORKERS=5
DANA_MCP_PATH=/mcp
DANA_DEPLOYMENT_MODE=local

# Authentication (persistent token; generate with scripts/init_token.py)
DANA_AUTH_TOKEN=GENERATE_WITH_SCRIPT
DANA_OAUTH_ACCESS_TOKEN_TTL_SECONDS=31536000

# Public exposure (Local Mode / Tailscale Funnel)
DANA_PUBLIC_HOST=
DANA_PUBLIC_PORT=0
DANA_PUBLIC_SCHEME=
DANA_TAILSCALE_FUNNEL_ENABLED=true
DANA_TAILSCALE_FUNNEL_CHECK_SECONDS=2
# Optional mirror for Tailscale static packages
# DANA_TAILSCALE_MIRROR=

# HTTP / security limits
DANA_RATE_LIMIT_RPM=120
DANA_AUTH_BURST=20
DANA_MAX_BODY_BYTES=10485760
DANA_ALLOWED_ORIGINS=

# Filesystem access policy (empty allowed = all paths unless denied)
# Use one path per line or comma-separated depending on loader.
DANA_ALLOWED_PATHS=
DANA_DENIED_PATHS=
# DANA_ACCESS_POLICY_FILE=config/access_policy.json

# Tool behavior
DANA_ALLOW_DANGEROUS_TOOLS=true
DANA_PROGRESSIVE_TOOLS=1
DANA_TOOL_CACHE=1

# Optional advanced
# DANA_LOG_DIR=
# DANA_RUNTIME_DIR=
# DANA_SETUP_PORT=
# DANA_TOKENIZER_ENCODING=
